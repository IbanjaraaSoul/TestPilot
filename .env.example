# --- AI: pick one (cloud only — no local Ollama) ---
# Option A: OpenAI
# OPENAI_API_KEY=sk-...

# Option B: Ollama Cloud — create a key: https://ollama.com/settings/keys
# OLLAMA_API_KEY=...
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# OLLAMA_MODEL=gemma4:31b-cloud
# OLLAMA_TIMEOUT_MS=120000
# OLLAMA_MAX_TOKENS= (omit for unlimited; set e.g. 4096 to cap output length)

# Optional: port for the POC server (default 3000).
# PORT=3000

# Optional: run Playwright in a visible browser so you can watch steps (default: true).
# PLAYWRIGHT_HEADED=true
# Optional: delay between steps in ms (default 800).
# PLAYWRIGHT_STEP_DELAY_MS=800

# Strict Playwright runner by default: skipped steps and failed text checks fail the run.
# Set to 1/true/yes for older lenient behavior (skips do not fail the suite).
# PLAYWRIGHT_LENIENT=false
